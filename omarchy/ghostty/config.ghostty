# ─── Colors ──────────────────────────────────────────────────────────
# Follows the active Omarchy theme (switches automatically with `omarchy theme set`)
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Subtle see-through background
background-opacity = 0.94
# Gently dim unfocused splits
unfocused-split-opacity = 0.85
minimum-contrast = 1.1

# ─── Font ────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 11
font-feature = calt
font-feature = liga
font-thicken = true
adjust-cell-height = 12%

# ─── Window ──────────────────────────────────────────────────────────
window-theme = ghostty
window-decoration = none
window-padding-x = 18
window-padding-y = 14
window-padding-balance = true
window-padding-color = extend
gtk-toolbar-style = flat
confirm-close-surface = false
resize-overlay = never

# ─── Cursor ──────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.9
mouse-hide-while-typing = true

# Shell integration (no-cursor lets the bar cursor stick; ssh-env fixes remote terminfo)
shell-integration-features = no-cursor,ssh-env,title

# Cursor trail: smears like a comet when the cursor jumps (sahaj-b/cursor-shaders, MIT)
# Swap for shaders/cursor_warp.glsl or shaders/ripple_cursor.glsl to try others,
# or comment out to disable.
custom-shader = shaders/cursor_tail.glsl
custom-shader-animation = true

# ─── Splits ──────────────────────────────────────────────────────────
# Drag a split by the handle at its top onto another split (also across tabs/windows)
drag-handle = auto

# ─── Quick terminal (drop-down, toggled with Super+§ in Hyprland) ───
quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-screen = main
quick-terminal-autohide = true
quick-terminal-keyboard-interactivity = on-demand

# ─── Behaviour ───────────────────────────────────────────────────────
# 1.4: "both" = system clipboard + middle-click selection (old 1.3 "clipboard" behaviour)
copy-on-select = both
scrollback-limit-bytes = 50000000
mouse-scroll-multiplier = 0.95
# Fix general slowness on Hyprland
async-backend = epoll

# ─── Keybinds (Omarchy defaults) ─────────────────────────────────────
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
# Split pane side-by-side (matches kitty: launch --location=vsplit --cwd=current)
keybind = ctrl+shift+enter=new_split:right
# Zoom the current split to fill the window (was on ctrl+shift+enter by default)
keybind = ctrl+shift+z=toggle_split_zoom
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100
